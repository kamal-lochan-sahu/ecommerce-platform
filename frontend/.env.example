# Luxora storefront - environment variables (set these in Vercel -> Project -> Settings -> Environment Variables).
# They are read at BUILD time, so redeploy after changing any of them.

# Backend API address (must end with /api)
VITE_API_URL=https://your-backend.onrender.com/api

# Brand used before the store settings load, plus the install-app (PWA) name and the browser tab title at build time.
# The name customers see on the site comes from Admin -> Settings -> Store Name.
VITE_CLIENT_NAME=Luxora
VITE_CLIENT_DESCRIPTION=Online store

# Theme colours (hex)
VITE_PRIMARY_COLOR=#6366f1
VITE_SECONDARY_COLOR=#f59e0b

# Razorpay PUBLIC key id (never the secret)
VITE_RAZORPAY_KEY_ID=
