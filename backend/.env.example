# ============================================================================
# Luxora backend - environment variables
# Copy to .env for local work. On Render set these in the dashboard.
# NEVER commit real values. Everything below is a placeholder.
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/luxora
FRONTEND_URL=http://localhost:5173
CLIENT_NAME=Luxora
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
CLIENT_SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=1800-000-0000

# ---- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d
# Secret used to hash OTP codes in the database. Falls back to JWT_SECRET if unset.
OTP_SECRET=change-me-third-long-random-string

# ============================================================================
# MESSAGING (SMS + email). Going live = change the values in this block only.
# ============================================================================

# ---- SMS ---------------------------------------------------------------------
#   console : prints SMS/OTP text in the server log (testing only - NOT for launch)
#   twilio  : real SMS through Twilio
#   (unset) : uses twilio if TWILIO_* below are set, otherwise SMS fails with a clear error
SMS_PROVIDER=console
# India requires the SMS text to match your DLT-registered template exactly.
# {{brand}} = CLIENT_NAME, {{otp}} = the code. Default is shown.
# SMS_OTP_TEMPLATE={{brand}} OTP: {{otp}}. Valid for 10 minutes. Do not share it with anyone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Email -------------------------------------------------------------------
#   console : prints emails (incl. OTP codes) in the server log (testing only - NOT for launch)
#   smtp    : real email through any SMTP provider (SES, SendGrid, Brevo, Postmark, Gmail...)
#   (unset) : uses smtp if SMTP_HOST (or legacy GMAIL_USER + GMAIL_PASS) is set, else email fails with a clear error
# NOTE: free Render instances block outbound SMTP ports; a paid instance does not.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Luxora
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Legacy Gmail settings (still supported when SMTP_HOST is empty):
GMAIL_USER=
GMAIL_PASS=
GMAIL_APP_PASSWORD=

# ---- Payments ----------------------------------------------------------------
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COD_ENABLED=true

# ---- Storage / cache ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Feature flags -----------------------------------------------------------
ENABLE_CRON_JOBS=true
GUEST_CHECKOUT=true
LOYALTY_ENABLED=true
MULTI_VENDOR=false
